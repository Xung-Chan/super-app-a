{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "types": [
      "jest"
    ],
    "paths": {
      "@navigation/*": [
        "src/core/navigation/*"
      ],
      "@api/*": [
        "src/core/api/*"
      ],
      "@post/*": [
        "src/features/post/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ]
}